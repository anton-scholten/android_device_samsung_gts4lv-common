# Audio
ro.vendor.qti.va_aosp.support=1

# Filesystem
fs_mgr.overlayfs.prefer_cache_backing_storage=true

# Netflix
ro.netflix.bsp_rev=Q670-14477-1

# OTA: LineageOS Updater feed for this version, on GitHub Pages (scripts/ota-json.sh in the docs repo).
# Non-ro properties are limited to 91 bytes.
lineage.updater.uri=https://anton-scholten.github.io/lineageos-galaxy-tab-s5e/ota/23.2/{device}.json
