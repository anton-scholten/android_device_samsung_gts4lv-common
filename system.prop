# Audio
ro.vendor.qti.va_aosp.support=1

# Filesystem
fs_mgr.overlayfs.prefer_cache_backing_storage=true

# Netflix
ro.netflix.bsp_rev=Q670-14477-1

# OTA: LineageOS Updater feed for this version (written by scripts/ota-json.sh in the docs repo)
lineage.updater.uri=https://raw.githubusercontent.com/anton-scholten/lineageos-galaxy-tab-s5e/main/ota/23.2/{device}.json
