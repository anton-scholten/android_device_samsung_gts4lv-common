android_app {
    name: "RoundedCorners",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["SettingsLibTile"],
    platform_apis: true,
    privileged: true,
    privapp_allowlist: "privapp-permissions-corners.xml",
    product_specific: true,
    required: ["SquareCornersOverlay"],
}

runtime_resource_overlay {
    name: "SquareCornersOverlay",
    manifest: "overlay/AndroidManifest.xml",
    resource_dirs: ["overlay/res"],
    product_specific: true,
}
