soong_namespace {
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

cc_library_static {
    name: "libpowermodeext_gts4lv",
    vendor: true,
    srcs: ["power/power-mode.cpp"],
    defaults: ["android.hardware.power-ndk_shared"],
    shared_libs: ["libbase"],
}
