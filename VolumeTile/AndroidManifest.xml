<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.gts4lv.volumetile">

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_volume">

        <service
            android:name=".VolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_volume"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_UTILITIES" />
        </service>

        <!-- Tap on the tile shows the system volume dialog. -->
        <activity
            android:name=".SystemVolumeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Long-press on the tile opens Settings > Sound & vibration. -->
        <activity
            android:name=".SoundSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
    </application>
</manifest>
